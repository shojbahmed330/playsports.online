# ---- Service Role (server-only, ADMIN — bypasses RLS) ----
# Get from: Supabase Dashboard → Project Settings → API → service_role key
# On Lovable Cloud, this is managed for you; on Vercel you must paste it manually.
SUPABASE_SERVICE_ROLE_KEY="paste-service-role-key-here"

# ---- Third-party API keys used by server functions ----
# Lovable AI Gateway (for any AI features). Only if you plan to use Lovable AI.
LOVABLE_API_KEY="paste-lovable-api-key-here"

# RapidAPI (used by sports data fetchers)
RAPIDAPI_KEY="paste-rapidapi-key-here"

# =====================================================================
# Build target flag (auto-set by vercel.json, but you can override)
# =====================================================================
# DEPLOY_TARGET=vercel
